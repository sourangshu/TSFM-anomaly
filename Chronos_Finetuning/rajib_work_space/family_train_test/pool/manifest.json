    "only": null,
    "context_length": 512,
    "prediction_length": 64,
    "stride": 64,
    "test_stride": 64,
    "min_length": 50,
    "p_anom": 0.3333333333333333,
    "min_anom_windows": 50,
    "min_anom_steps_test": 500,
    "use_syn_data": true,
    "syn_dir": "syn_data",
    "file_weight_alpha": 1.0,
    "file_weight_cap": 5.0,
    "file_feat_max_windows": 200,
    "no_val": true,
    "val_only": false,
    "val_per_dataset": 200,
    "val_stride": 16,
    "val_p_anom": 0.3333333333333333,
    "seed": 42
  },
  "families": {
    "ecg": {
      "family": "ECG / physiological",
      "train": [
        "MITDB"
      ],
      "holdout": [
        "SVDB"
      ],
      "tier": 1,
      "note": "Both 2-lead ECG, F=3, ~13% anomalous, same anomaly semantics (arrhythmic beats). The flagship."
    },
    "spacecraft": {
      "family": "Spacecraft telemetry",
      "train": [
        "SMAP"
      ],
      "holdout": [
        "MSL"
      ],
      "tier": 1,
      "note": "Both NASA telemetry. F differs (SMAP 26 / MSL 56); most channels are one-hot command flags."
    },
    "env_iot": {
      "family": "Environmental / building IoT",
      "train": [
        "CalIt2",
        "GECCO"
      ],
      "holdout": [
        "metro",
        "room-occupancy"
      ],
      "tier": 2,
      "caveat": "Both held-out sets are anomaly-sparse (metro ~31 anomalous timesteps; room-occupancy small). VUS-PR is noise-dominated -- a bad number does NOT mean transfer failed. CalIt2 in the train pool is itself anomaly-sparse (~138 steps), so its level-3 anomalous branch is thin.",
      "note": "Weakest grouping: door counts (CalIt2) + water quality (GECCO) -> freeway traffic (metro) + room CO2 (room-occupancy) is 'has sensors', not one domain."
    },
    "industrial": {
      "family": "Industrial process",
      "train": [
        "GHL"
      ],
      "holdout": [
        "Genesis"
      ],
      "tier": 2,
      "caveat": "Genesis has ~28 anomalous timesteps TOTAL (0.30% of 9332). VUS-PR is noise-dominated; a bad number does NOT mean transfer failed.",
      "note": "Reverse direction (train on Genesis) is not viable -- far too few anomaly windows."
    },
    "server": {
      "family": "Server / cloud metrics",
      "train": [
        "SMD",
        "Exathlon"
      ],
      "holdout": [
        "PSM",
        "cicids"
      ],
      "tier": 1,
      "caveat": "cicids* is a stretch of 'server': it is network intrusion traffic, not host/cloud metrics. Report its row with that asterisk -- a null there may be sub-domain mismatch, not failed transfer. PSM (anomaly-dense, ~32%) is the clean server-family holdout.",
      "note": "PSM held out: 1 file, well-conditioned VUS-PR. cicids held out: 6 files, network flows."
    },
    "activity": {
      "family": "Human activity",
      "train": [
        "Daphnet"
      ],
      "holdout": [
        "OPPORTUNITY"
      ],
      "tier": 1,
      "note": "Same sensor modality (body-worn IMU) but DIFFERENT anomaly semantics (freezing-of-gait vs activity transition). A null result here is ambiguous between domain mismatch and label mismatch."
    }
  },
